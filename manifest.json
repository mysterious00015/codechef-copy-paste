
{
  "manifest_version": 3,
  "name": "Mysterious | Universal Copy",
  "version": "2.4.0",
  "description": "Premium one-click code copying with configurable editor compatibility.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
